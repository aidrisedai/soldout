{
  "name": "soldout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "poll": "tsx --env-file=.env scripts/poll.ts",
    "reset": "tsx --env-file=.env scripts/reset.ts",
    "worker": "tsx --env-file=.env scripts/poll.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@mobilerun/sdk": "^6.1.0",
    "@prisma/client": "^6.19.3",
    "next": "15.5.29",
    "pdfkit": "^0.20.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=22"
  }
}

# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"

# Agent model: Claude through Naive's model proxy (preferred), or Anthropic directly.
NAIVE_API_KEY=
# NAIVE_BASE_URL=https://api.vetta.sh/v1/proxy/anthropic
# AGENT_MODEL=anthropic/claude-opus-5.5
ANTHROPIC_API_KEY=

# Mobilerun Cloud (dr_sk_...). MOBILERUN_NUMBER_ID is optional; the first active number is used.
MOBILERUN_API_KEY=
# MOBILERUN_NUMBER_ID=
# MOBILERUN_WEBHOOK_SECRET=

# Stripe payment link, TEST MODE ONLY until the organizer says otherwise.
STRIPE_PAYMENT_LINK=

# WhatsApp Cloud API (Meta). Webhook URL: https://<public-host>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=   # any string you choose; paste the same in Meta's webhook config
WHATSAPP_APP_SECRET=     # App settings > Basic > App secret; used to verify webhook signatures
# WHATSAPP_API_VERSION=v23.0

# Telegram (optional): token from @BotFather
TELEGRAM_BOT_TOKEN=

# Organizer number allowed to send "DOT <request>" commands over WhatsApp
ORGANIZER_PHONE=

# Production
DASHBOARD_PASSWORD=
# MOBILERUN_DEVICE_ID=

# Monid research (monid_live_...)
MONID_API_KEY=

# AgentMail outreach email (free tier: 3 inboxes, 100 emails/day)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

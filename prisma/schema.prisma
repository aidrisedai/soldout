generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// One paid program an organizer wants to fill. Content, contacts and
// messages are always scoped to a single event and never mixed.
model Event {
  id              String   @id @default(cuid())
  keyword         String   @unique // parents text "JOIN <keyword>"
  name            String
  organizerName   String
  organization    String
  goalSeats       Int?
  deadline        String?
  price           String?
  dateText        String?
  place           String?
  audience        String?
  applyLink       String? // where parents enroll and pay
  paymentLink     String? // Stripe test payment link
  content         String // the organizer's own content; the ONLY source of answers
  fitQuestions    String // JSON: [{ key, question }]
  clips           String   @default("[]") // JSON: [{ id, title, url, answers }]
  accounts        String   @default("{}") // JSON: organizer accounts to act from { linkedin, instagram, email }
  autopilot       Boolean  @default(true) // running; false = stopped (nothing is sent)
  mode            String   @default("approve") // approve = organizer approves strategy + first messages; auto = fully autonomous
  createdAt       DateTime @default(now())

  contacts      Contact[]
  messages      Message[]
  fitAnswers    FitAnswer[]
  outcomes      Outcome[]
  flags         OrganizerFlag[]
  strategies    Strategy[]
}

// A person who texted JOIN for one event. Same phone on two events = two contacts.
model Contact {
  id         String    @id @default(cuid())
  eventId    String
  phone      String
  channel    String    @default("simulate") // simulate | sms | telegram | whatsapp
  status     String    @default("active") // active | opted_out
  stage      String    @default("fit") // fit | qa | link_sent | paid | builder
  program    String? // founder | builder
  referredBy String? // connector JOIN code that brought them in
  optedInAt  DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages   Message[]
  fitAnswers FitAnswer[]
  outcomes   Outcome[]
  flags      OrganizerFlag[]

  @@unique([eventId, phone])
}

model Message {
  id         String   @id @default(cuid())
  eventId    String
  contactId  String
  direction  String // in | out
  body       String
  channel    String // simulate | sms | telegram | whatsapp
  status     String   @default("ok") // ok | queued | sent | failed | not_sendable
  externalId String?  @unique // Mobilerun message id
  attachment String? // local file path (e.g. brief PDF) to send with this message
  error      String?
  createdAt  DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model FitAnswer {
  id        String   @id @default(cuid())
  eventId   String
  contactId String
  key       String
  question  String
  answer    String
  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, key])
}

// opted_in | answered | clip_sent | link_sent | paid | needs_organizer | routed_builder | opted_out
model Outcome {
  id        String   @id @default(cuid())
  eventId   String
  contactId String
  type      String
  detail    String?
  createdAt DateTime @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

// A question the content can't answer, or a topic only the organizer may answer.
model OrganizerFlag {
  id         String    @id @default(cuid())
  eventId    String
  contactId  String
  question   String
  reason     String
  status     String    @default("open") // open | answered
  reply      String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

// Phase 2: Good Strategy / Bad Strategy kernel, approved before anyone is contacted.
model Strategy {
  id         String    @id @default(cuid())
  eventId    String
  body       String // JSON: { diagnosis, policies[], whoNext[] }
  status     String    @default("draft") // draft | approved
  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Bookkeeping for the Mobilerun inbox poller.
model KV {
  key   String @id
  value String
}

// Videos/clips found by Dot (ChatGPT on the Mobilerun phone) or cut by Naive Clips.
// The agent only sends media the organizer approved.
model MediaItem {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  url       String
  answers   String // which parent question it answers
  source    String // dot | naive_clip | organizer
  kind      String   @default("video") // video | pdf
  status    String   @default("proposed") // proposed | approved | rejected
  createdAt DateTime @default(now())
}

model DotTask {
  id        String   @id @default(cuid())
  eventId   String
  taskId    String? // Mobilerun task id
  kind      String   @default("find_videos") // find_videos | make_pdf | make_video
  status    String   @default("running") // running | done | failed
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-page program brief PDF per event, drafted only from the organizer's content.
model Brief {
  id         String    @id @default(cuid())
  eventId    String
  body       String // JSON: { title, tagline, sections[], howToApply }
  pdfPath    String
  status     String    @default("draft") // draft | approved
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
}

// ---- Outreach (docs/FLOW.md) ----

// Organizer's own network for warm intros, and accounts to act from.
model NetworkContact {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  relationship String? // how the organizer knows them
  community    String?
  contact      String? // email / phone / profile URL
  createdAt    DateTime @default(now())
}

// A community or organization a guiding policy points to. Researched, then GO / NO-GO.
model Target {
  id         String   @id @default(cuid())
  eventId    String
  strategyId String?
  policy     String // which guiding policy it serves
  name       String
  kind       String   @default("community") // community | organization
  research   String? // JSON: { summary, needs[], fit, howIn, sources[] }
  fitScore   Int? // 0-100
  decision   String   @default("pending") // pending | go | no_go
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A person in a GO community we may reach (connectors first).
model Prospect {
  id          String   @id @default(cuid())
  eventId     String
  targetId    String
  name        String
  role        String?
  whyThem     String?
  reach       String? // connector | member
  channels    String   @default("{}") // JSON: { linkedin?, instagram?, email?, whatsapp? }
  research    String? // JSON notes + sources
  opener      String? // first message, in the organizer's voice
  joinCode    String?  @unique
  status      String   @default("found") // found | approved | contacted | replied | engaged | bought | referred | not_now | done
  aiPaused    Boolean  @default(false) // human took over
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One step on the channel ladder, or a message in a connector conversation.
model Touch {
  id         String   @id @default(cuid())
  prospectId String
  channel    String // linkedin | email | instagram | intro | whatsapp
  direction  String // out | in
  threadId   String? // email thread (AgentMail)
  externalId String? // provider message id
  author     String   @default("ai") // ai | organizer | contact
  body       String
  status     String   @default("draft") // draft | approved | sent | failed | received
  error      String?
  createdAt  DateTime @default(now())
}
